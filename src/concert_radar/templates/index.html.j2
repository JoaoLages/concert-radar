<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Concert Radar</title>
<style>
  :root {
    --bg: #fafaf9; --fg: #1c1917; --muted: #78716c; --line: #e7e5e4;
    --accent: #c2410c; --chip: #f5f5f4; --new-bg: #ffedd5; --new-fg: #9a3412;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #1c1917; --fg: #f5f5f4; --muted: #a8a29e; --line: #44403c;
      --accent: #fb923c; --chip: #292524; --new-bg: #431407; --new-fg: #fdba74;
    }
  }
  * { box-sizing: border-box; }
  [hidden] { display: none !important; }
  body { margin: 0; background: var(--bg); color: var(--fg);
         font: 15px/1.45 system-ui, -apple-system, "Segoe UI", sans-serif; }
  main { max-width: 760px; margin: 0 auto; padding: 24px 16px 64px; }
  header { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px; }
  h1 { font-size: 24px; margin: 0 0 4px; }
  .sub { color: var(--muted); margin: 0 0 16px; }
  button, input { font: inherit; color: var(--fg); }
  .account button, .toolbar button { border: 1px solid var(--line); background: var(--chip); border-radius: 999px;
         padding: 4px 12px; cursor: pointer; }
  .toolbar { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-bottom: 12px; }
  .toolbar .primary { background: var(--fg); color: var(--bg); border-color: var(--fg); margin-left: auto; }
  .toolbar .primary:disabled { opacity: .4; cursor: default; }
  .account { color: var(--muted); font-size: 14px; }
  .tabs { display: flex; gap: 4px; border-bottom: 1px solid var(--line); margin-bottom: 16px; }
  .tabs button { border: 0; background: none; padding: 8px 12px; cursor: pointer; color: var(--muted);
         border-bottom: 2px solid transparent; margin-bottom: -1px; }
  .tabs button[aria-selected="true"] { color: var(--fg); border-bottom-color: var(--accent); font-weight: 600; }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 20px; }
  .filters button, .filters input, .search { border: 1px solid var(--line); background: var(--chip);
         border-radius: 999px; padding: 6px 14px; }
  .filters input, .search { flex: 1 1 180px; border-radius: 8px; }
  .search { width: 100%; margin-bottom: 12px; }
  .filters button[aria-pressed="true"] { background: var(--fg); color: var(--bg); border-color: var(--fg); }
  h2 { font-size: 13px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted);
       margin: 28px 0 6px; }
  .show { display: grid; grid-template-columns: 64px 1fr; gap: 12px; padding: 10px 0;
          border-top: 1px solid var(--line); }
  .date { font-variant-numeric: tabular-nums; color: var(--muted); }
  .date b { display: block; color: var(--fg); font-size: 18px; }
  .title { font-weight: 600; }
  .match { font-size: 13px; color: var(--muted); }
  .related { border: 1px solid var(--line); border-radius: 4px; padding: 0 5px; margin-left: 6px; font-size: 11px; }
  .related-toggle { font: inherit; font-size: 12px; color: var(--muted); background: none; border: 1px solid var(--line);
                    border-radius: 999px; padding: 1px 8px; cursor: pointer; white-space: nowrap; }
  .related-toggle[aria-pressed="true"] { color: var(--bg); background: var(--accent); border-color: var(--accent); }
  .new { background: var(--new-bg); color: var(--new-fg); font-size: 11px; font-weight: 600;
         border-radius: 4px; padding: 1px 6px; margin-left: 6px; vertical-align: 2px; }
  .where, .count { color: var(--muted); }
  .links a { color: var(--accent); margin-right: 10px; font-size: 13px; }
  .months { position: sticky; top: 0; z-index: 1; background: var(--bg); display: flex; gap: 6px;
            overflow-x: auto; padding: 8px 0; margin-bottom: 4px; border-bottom: 1px solid var(--line); }
  .months a { flex: none; font-size: 13px; color: var(--fg); text-decoration: none; border: 1px solid var(--line);
              background: var(--chip); border-radius: 999px; padding: 3px 10px; }
  h2 { scroll-margin-top: 52px; }
  .unfollow { font: inherit; font-size: 12px; color: var(--muted); background: none; border: 1px solid var(--line);
              border-radius: 999px; padding: 0 8px; margin-left: 8px; cursor: pointer; vertical-align: 1px; }
  .notice button { font: inherit; color: var(--accent); background: none; border: 0; padding: 0; margin-left: 8px;
                   cursor: pointer; text-decoration: underline; }
  .row { display: flex; align-items: center; gap: 12px; padding: 8px 0; border-top: 1px solid var(--line); cursor: pointer; }
  .row input { width: 18px; height: 18px; margin: 0; accent-color: var(--accent); }
  .row .name { flex: 1; min-width: 0; overflow-wrap: anywhere; }
  .count { font-size: 13px; white-space: nowrap; }
  .notice { background: var(--chip); border: 1px solid var(--line); border-radius: 8px; padding: 10px 14px; margin-bottom: 16px; }
  .empty { color: var(--muted); padding: 24px 0; }
  footer { margin-top: 40px; padding-top: 12px; border-top: 1px solid var(--line); color: var(--muted); font-size: 13px; }
  footer .down { color: var(--accent); }
</style>
</head>
<body>
<main>
  <header>
    <h1>Concert Radar</h1>
    <div class="account" id="account"></div>
  </header>
  <p class="sub">Upcoming shows in Portugal and Spain for {{ artist_count }} artists in my Spotify playlists. Updated {{ today.isoformat() }}.</p>
  <p class="notice" id="notice" hidden></p>
  <nav class="tabs" role="tablist">
    <button role="tab" data-tab="shows" aria-selected="true">Shows</button>
    <button role="tab" data-tab="following" aria-selected="false">Following</button>
    <button role="tab" data-tab="add" aria-selected="false">Add from playlists</button>
  </nav>

  <section id="tab-shows">
    <div class="filters">
      <button data-country="" aria-pressed="true">All</button>
      {% for country in countries %}<button data-country="{{ country.value }}" aria-pressed="false">{{ country.name.title() }}</button>
      {% endfor %}<button data-new aria-pressed="false">New this week</button>
      <input type="search" placeholder="Search artist, venue or city" aria-label="Search shows">
    </div>
    <nav class="months" aria-label="Jump to month"></nav>
    {% set ns = namespace(month=none) %}
    {% for show in shows %}
      {% set month = show.starts_on.strftime("%B %Y") %}
      {% set is_new = (today - show.first_seen).days < new_days %}
      {% if month != ns.month %}<h2 id="month-{{ show.starts_on.strftime('%Y-%m') }}">{{ month }}</h2>{% set ns.month = month %}{% endif %}
      <div class="show" data-country="{{ show.country.value }}" data-new="{{ is_new }}"
           data-ids="{{ show.artist_ids | join(' ') }}" data-kind="{{ show.kind.value }}"
           data-text="{{ (show.titles | join(' ') ~ ' ' ~ show.artist ~ ' ' ~ show.venue ~ ' ' ~ show.city) | lower }}">
        <div class="date"><b>{{ show.starts_on.day }}</b>{{ show.starts_on.strftime("%a") }}</div>
        <div>
          <span class="title">{{ show.titles | join(" · ") }}</span>{% if is_new %}<span class="new">NEW</span>{% endif %}
          <div class="match"><span class="artist">{{ show.artist }}</span>{% if show.kind.value == "related" %}<span class="related" title="A tribute, cover or other show about the artist">related</span>{% endif %}<button class="unfollow" hidden>Unfollow</button></div>
          <div class="where">{{ show.venue }}{% if show.city %}, {{ show.city }}{% endif %} · {{ show.country.name.title() }}</div>
          <div class="links">{% for source, url in show.links.items() %}<a href="{{ url }}" rel="noopener">{{ source.value }}</a>{% endfor %}</div>
        </div>
      </div>
    {% else %}
      <p class="empty">No upcoming shows found for any playlist artist.</p>
    {% endfor %}
    <p class="empty" id="no-results" hidden>No shows match these filters.</p>
  </section>

  {% for tab, placeholder in [("following", "Search artists you follow"), ("add", "Search your playlist artists")] %}
  <section id="tab-{{ tab }}" hidden>
    <div class="checklist" hidden>
      <input class="search" type="search" placeholder="{{ placeholder }}" aria-label="{{ placeholder }}">
      <div class="toolbar">
        <button data-select="shows">Select all with upcoming shows</button>
        <button data-select="all">Select all</button>
        <button data-select="none">Clear</button>
        <button class="primary" disabled></button>
      </div>
      <div class="list"></div>
    </div>
    <p class="empty prompt"></p>
  </section>
  {% endfor %}

  <footer>Spotify
    <span class="{{ 'ok' if artists_read_on == today else 'down' }}">{% if artists_read_on == today %}✓{% else %}✗ using artists from {{ artists_read_on.strftime("%-d %b") }}{% endif %}</span> · Sources:
    {% for source in sources %}{% set worked = last_worked.get(source) %}
    <span class="{{ 'ok' if worked == today else 'down' }}">{{ source.value }}
      {% if worked == today %}✓{% elif worked %}✗ last worked {{ worked.strftime("%-d %b") }}{% else %}✗ never worked{% endif %}</span>{% if not loop.last %} · {% endif %}
    {% endfor %}
  </footer>
</main>
<script id="radar-data" type="application/json">{{ page_data | tojson }}</script>
<script>
  const DATA = JSON.parse(document.getElementById("radar-data").textContent);
  const LOGIN = DATA.login;
  const UPCOMING = new Map(DATA.artists.map(a => [a.id, a.upcoming]));
  const RELATED = new Map(DATA.artists.map(a => [a.id, a.related]));
  const NAMES = new Map(DATA.artists.map(a => [a.id, a.name]));
  const API = "https://api.spotify.com/v1";

  // Browser storage can be unavailable (private windows, blocked site data); the page still works logged out.
  const store = {
    get: k => { try { return localStorage.getItem("radar:" + k); } catch { return null; } },
    set: (k, v) => { try { localStorage.setItem("radar:" + k, v); } catch {} },
    del: k => { try { localStorage.removeItem("radar:" + k); } catch {} },
  };

  let followed = null; // Map of Spotify artist ID -> name, once logged in
  let activeTab = "shows";

  function notice(text, undo) {
    const el = document.getElementById("notice");
    el.replaceChildren(text || "");
    if (undo) {
      const button = document.createElement("button");
      button.textContent = "Undo";
      button.onclick = undo;
      el.append(button);
    }
    el.hidden = !text;
  }

  // --- Spotify login (authorization code with PKCE: no secret in the page) ---
  function base64url(bytes) {
    return btoa(String.fromCharCode(...bytes)).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
  }
  async function login() {
    const verifier = base64url(crypto.getRandomValues(new Uint8Array(48)));
    store.set("verifier", verifier);
    const challenge = base64url(new Uint8Array(await crypto.subtle.digest("SHA-256", new TextEncoder().encode(verifier))));
    location.href = "https://accounts.spotify.com/authorize?" + new URLSearchParams({
      client_id: LOGIN.client_id, response_type: "code", redirect_uri: LOGIN.redirect_uri,
      scope: LOGIN.scope, code_challenge_method: "S256", code_challenge: challenge,
    });
  }
  function logout() {
    ["access", "expires", "refresh", "verifier"].forEach(store.del);
    followed = null;
    render();
  }
  async function requestToken(params) {
    const response = await fetch("https://accounts.spotify.com/api/token", {
      method: "POST",
      headers: { "Content-Type": "application/x-www-form-urlencoded" },
      body: new URLSearchParams({ client_id: LOGIN.client_id, ...params }),
    });
    if (!response.ok) {
      // A refresh token stops working when it's revoked or replaced (e.g. by another tab); start over.
      if (params.grant_type === "refresh_token") {
        ["access", "expires", "refresh"].forEach(store.del);
        throw new Error("Your Spotify login expired. Log in again.");
      }
      throw new Error("Spotify login failed (" + response.status + ")");
    }
    const token = await response.json();
    store.set("access", token.access_token);
    store.set("expires", String(Date.now() + (token.expires_in - 60) * 1000));
    if (token.refresh_token) store.set("refresh", token.refresh_token);
  }
  async function finishLoginRedirect() {
    const params = new URLSearchParams(location.search);
    if (!params.has("code") && !params.has("error")) return;
    history.replaceState(null, "", LOGIN.redirect_uri);
    if (params.has("error")) { notice("Spotify login was cancelled."); return; }
    await requestToken({ grant_type: "authorization_code", code: params.get("code"),
      redirect_uri: LOGIN.redirect_uri, code_verifier: store.get("verifier") || "" });
    store.del("verifier");
  }
  async function accessToken() {
    if (store.get("access") && Date.now() < Number(store.get("expires"))) return store.get("access");
    await requestToken({ grant_type: "refresh_token", refresh_token: store.get("refresh") });
    return store.get("access");
  }
  async function spotify(method, path) {
    let response;
    for (let attempt = 0; attempt < 4; attempt++) {
      response = await fetch(API + path, { method, headers: { Authorization: "Bearer " + await accessToken() } });
      let wait;
      if (response.status === 429) {
        // Rate limited: wait as long as Spotify asks, unless that's too long to sit on a page.
        wait = Number(response.headers.get("Retry-After") || 2);
        if (wait > 30) throw new Error("Spotify is limiting requests right now. Try again in " + Math.ceil(wait / 60) + " minutes.");
      } else if (response.status >= 500) {
        wait = 2 ** attempt;  // Spotify's own errors are usually momentary: 1, 2, then 4 seconds
      } else {
        break;
      }
      await new Promise(r => setTimeout(r, 1000 * wait));
    }
    if (response.status === 403) throw new Error("Spotify refused access. Only users added to the Spotify app (Dashboard → User Management) can log in.");
    if (!response.ok) throw new Error("Spotify request failed (" + response.status + ")");
    return response.status === 204 ? null : response.json().catch(() => null);
  }
  // A full read takes Spotify one request per 50 artists, one after another, so it's done at most hourly;
  // follows and unfollows made here keep the remembered list current in between.
  const FULL_READ_EVERY_MS = 60 * 60 * 1000;
  let user = null;
  let loadFailed = false;  // the follow list couldn't be read; offer to retry instead of "Loading…"
  async function loadFollowed() {
    const map = new Map();
    let path = "/me/following?type=artist&limit=50";
    while (path) {
      const page = (await spotify("GET", path)).artists;
      page.items.forEach(a => { map.set(a.id, a.name); if (!NAMES.has(a.id)) NAMES.set(a.id, a.name); });
      path = page.next ? page.next.replace(API, "") : null;
    }
    followed = map;
    store.set("followed_read_at", String(Date.now()));
    saveFollowed();
  }
  // Remembered so the page shows your follows instantly on every visit and login.
  function saveFollowed() {
    store.set("followed", JSON.stringify([...followed]));
    store.set("followed_user", user);
  }
  // Spotify takes at most 40 artists per follow or unfollow request.
  async function setFollowing(ids, follow, progress) {
    const batches = [];
    for (let i = 0; i < ids.length; i += 40) batches.push(ids.slice(i, i + 40));
    let done = 0;
    // Four requests at a time: much faster than one by one, and gentle enough on Spotify's limits.
    await Promise.all(Array.from({ length: Math.min(4, batches.length) }, async () => {
      while (batches.length) {
        const batch = batches.shift();
        await spotify(follow ? "PUT" : "DELETE",
          "/me/library?uris=" + encodeURIComponent(batch.map(id => "spotify:artist:" + id).join(",")));
        batch.forEach(id => follow ? followed.set(id, NAMES.get(id)) : followed.delete(id));
        saveFollowed();
        done += batch.length;
        progress(done);
      }
    }));
  }

  // --- Rendering ---
  function renderAccount() {
    const el = document.getElementById("account");
    el.replaceChildren();
    const button = document.createElement("button");
    if (followed) {
      el.append("Following " + followed.size + (followed.size === 1 ? " artist · " : " artists · "));
      button.textContent = "Log out";
      button.onclick = logout;
    } else if (store.get("refresh") && loadFailed) {
      el.append("Couldn't load your follows \u00b7 ");
      const retry = document.createElement("button");
      retry.textContent = "Retry";
      retry.onclick = startSession;
      el.append(retry, " ");
      button.textContent = "Log out";
      button.onclick = logout;
    } else if (store.get("refresh")) {
      el.append("Loading your Spotify follows\u2026");
      return;
    } else {
      button.textContent = "Log in with Spotify";
      button.onclick = login;
    }
    el.append(button);
  }
  // The Following and Add tabs are the same checklist over different artists.
  const CHECKLISTS = {
    following: {
      artists: () => [...followed.keys()],
      follow: false,
      action: "Unfollow",
      loggedOut: "Log in with Spotify to see the artists you follow.",
      nothing: "You don't follow any artists yet. Pick some in \u201cAdd from playlists\u201d.",
    },
    add: {
      artists: () => DATA.artists.map(a => a.id).filter(id => !followed.has(id)),
      follow: true,
      action: "Follow",
      loggedOut: "Log in with Spotify to follow artists from your playlists.",
      nothing: "You already follow every artist in your playlists.",
    },
  };
  const selected = { following: new Set(), add: new Set() };
  // Artists whose tributes, covers and other related shows you also want; kept in this browser only.
  let relatedOn = new Set();
  try { relatedOn = new Set(JSON.parse(store.get("related") || "[]")); } catch {}
  function setRelated(id, on) {
    on ? relatedOn.add(id) : relatedOn.delete(id);
    store.set("related", JSON.stringify([...relatedOn]));
    applyShowFilters();
  }
  function countText(id) {
    const upcoming = UPCOMING.get(id) || 0, related = RELATED.get(id) || 0;
    const parts = [];
    if (upcoming) parts.push(upcoming + (upcoming === 1 ? " upcoming show" : " upcoming shows"));
    if (related) parts.push(related + " related");
    return parts.join(" · ") || "no shows found";
  }

  function renderChecklist(tab) {
    const config = CHECKLISTS[tab];
    const section = document.getElementById("tab-" + tab);
    const checklist = section.querySelector(".checklist");
    const prompt = section.querySelector(".prompt");
    const ids = followed ? config.artists() : [];
    checklist.hidden = !ids.length;
    prompt.hidden = !!ids.length;
    prompt.textContent = followed ? config.nothing : config.loggedOut;
    if (!ids.length) return;

    const query = section.querySelector(".search").value.trim().toLowerCase();
    const visible = ids
      .filter(id => !query || NAMES.get(id).toLowerCase().includes(query))
      .sort((a, b) => (UPCOMING.get(b) || 0) - (UPCOMING.get(a) || 0) || NAMES.get(a).localeCompare(NAMES.get(b)));
    const chosen = selected[tab];
    const present = new Set(ids);
    [...chosen].forEach(id => { if (!present.has(id)) chosen.delete(id); });
    const go = section.querySelector(".primary");
    const updateButton = () => {
      go.textContent = config.action + " selected (" + chosen.size + ")";
      go.disabled = !chosen.size;
    };
    section.querySelector(".list").replaceChildren(...visible.map(id => {
      const row = document.createElement("label");
      row.className = "row";
      const box = document.createElement("input");
      box.type = "checkbox";
      box.checked = chosen.has(id);
      box.onchange = () => { box.checked ? chosen.add(id) : chosen.delete(id); updateButton(); };
      const name = document.createElement("span");
      name.className = "name";
      name.textContent = NAMES.get(id);
      const count = document.createElement("span");
      count.className = "count";
      count.textContent = countText(id);
      row.append(box, name, count);
      if (tab === "following") {
        const toggle = document.createElement("button");
        toggle.className = "related-toggle";
        toggle.textContent = "+ related events";
        toggle.title = "Also show tributes, covers and other shows about this artist";
        toggle.setAttribute("aria-pressed", relatedOn.has(id));
        toggle.onclick = event => {
          event.preventDefault();  // the row is a label; don't tick its checkbox
          setRelated(id, !relatedOn.has(id));
          toggle.setAttribute("aria-pressed", relatedOn.has(id));
        };
        row.append(toggle);
      }
      return row;
    }));
    section.querySelectorAll("[data-select]").forEach(button => {
      button.onclick = () => {
        if (button.dataset.select === "none") chosen.clear();
        visible.forEach(id => {
          if (button.dataset.select === "all" || (button.dataset.select === "shows" && UPCOMING.get(id))) chosen.add(id);
        });
        renderChecklist(tab);
      };
    });
    go.onclick = async () => {
      const ids = [...chosen];
      go.disabled = true;
      try {
        await setFollowing(ids, config.follow, done => { go.textContent = config.action + "ing\u2026 " + done + "/" + ids.length; });
        chosen.clear();
      } catch (error) {
        notice(error.message);
      }
      render();
    };
    updateButton();
  }

  const filterButtons = document.querySelectorAll(".filters button");
  const showSearch = document.querySelector(".filters input");
  const filters = { country: "", onlyNew: false };
  function applyShowFilters() {
    const query = showSearch.value.trim().toLowerCase();
    let visible = 0;
    document.querySelectorAll(".show").forEach(row => {
      const ids = row.dataset.ids.split(" ");
      const show = (!followed || ids.some(id => followed.has(id) && (row.dataset.kind === "artist" || relatedOn.has(id))))
        && (!filters.country || row.dataset.country === filters.country)
        && (!filters.onlyNew || row.dataset.new === "True")
        && (!query || row.dataset.text.includes(query));
      row.hidden = !show;
      row.querySelector(".unfollow").hidden = !followed;
      visible += show;
    });
    const months = document.querySelector(".months");
    months.replaceChildren();
    document.querySelectorAll("#tab-shows h2").forEach(h => {
      let next = h.nextElementSibling, any = false;
      while (next && next.tagName !== "H2") { if (next.classList.contains("show") && !next.hidden) any = true; next = next.nextElementSibling; }
      h.hidden = !any;
      if (!any) return;
      const link = document.createElement("a");
      link.href = "#" + h.id;
      link.textContent = h.textContent.replace(/(\w{3})\w* (\d{4})/, "$1 $2");
      months.append(link);
    });
    months.hidden = !months.children.length;
    const empty = document.getElementById("no-results");
    empty.hidden = visible > 0 || !document.querySelector(".show");
    empty.textContent = followed && !followed.size
      ? "You don't follow any artists yet. Pick some in “Add from playlists”."
      : "No shows match these filters.";
  }
  filterButtons.forEach(b => b.addEventListener("click", () => {
    if (b.hasAttribute("data-new")) { filters.onlyNew = !filters.onlyNew; b.setAttribute("aria-pressed", filters.onlyNew); }
    else {
      filters.country = b.dataset.country;
      filterButtons.forEach(o => { if (!o.hasAttribute("data-new")) o.setAttribute("aria-pressed", o === b); });
    }
    applyShowFilters();
  }));
  showSearch.addEventListener("input", applyShowFilters);
  document.getElementById("tab-shows").addEventListener("click", async event => {
    const button = event.target.closest(".unfollow");
    if (!button) return;
    const row = button.closest(".show");
    const ids = row.dataset.ids.split(" ").filter(id => followed.has(id));
    const name = row.querySelector(".artist").textContent;
    button.disabled = true;
    try {
      await setFollowing(ids, false, () => {});
      notice("Unfollowed " + name + ".", async () => {
        notice("");
        try { await setFollowing(ids, true, () => {}); } catch (error) { notice(error.message); }
        render();
      });
    } catch (error) {
      notice(error.message);
    }
    button.disabled = false;
    render();
  });
  Object.keys(CHECKLISTS).forEach(tab =>
    document.querySelector("#tab-" + tab + " .search").addEventListener("input", () => renderChecklist(tab)));

  function render() {
    renderAccount();
    applyShowFilters();
    if (activeTab in CHECKLISTS) renderChecklist(activeTab);
  }
  document.querySelectorAll(".tabs button").forEach(tab => tab.addEventListener("click", () => {
    activeTab = tab.dataset.tab;
    document.querySelectorAll(".tabs button").forEach(t => t.setAttribute("aria-selected", t === tab));
    document.querySelectorAll("main > section").forEach(s => { s.hidden = s.id !== "tab-" + activeTab; });
    render();
  }));

  async function startSession() {
    loadFailed = false;
    notice("");
    try {
      await finishLoginRedirect();
      if (store.get("refresh")) {
        try {
          const cached = store.get("followed");
          if (cached) followed = new Map(JSON.parse(cached));
        } catch {}
        render();
        user = (await spotify("GET", "/me")).id;
        const stale = Date.now() - Number(store.get("followed_read_at") || 0) > FULL_READ_EVERY_MS;
        if (!followed || store.get("followed_user") !== user || stale) {
          if (store.get("followed_user") !== user) followed = null;
          render();
          await loadFollowed();
        }
      }
    } catch (error) {
      if (!store.get("refresh")) followed = null;
      loadFailed = !followed;
      notice(error.message);
    }
    render();
  }
  startSession();
</script>
</body>
</html>
